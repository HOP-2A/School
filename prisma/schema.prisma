generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum SubmissionStatus {
  NONSUBMITTED
  SUBMITTED

}
model Class {
  id        String     @id @default(nanoid())
  name      String
  createdAt DateTime   @default(now())
  teacherId String?
  teacher   Teacher?   @relation(fields: [teacherId], references: [id])
  homework  Homework[]
  students  Student[]
}

model Student {
  id                  String               @id @default(nanoid())
  name                String
  clerkId             String               @unique
  email               String
  classId             String?
  createdAt           DateTime             @default(now())
  homeworkSubmissions HomeworkSubmission[]
  class               Class?               @relation(fields: [classId], references: [id])
}

model Teacher {
  id        String     @id @default(nanoid())
  name      String
  email     String
  clerkId   String     @unique
  createdAt DateTime   @default(now())
  classes   Class[]
  homeworks Homework[]
  subject   Subject?
}

model Subject {
  id          String   @id @default(nanoid())
  subjectName String
  teacherId   String   @unique
  createdAt   DateTime @default(now())
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
}

model Homework {
  id          String               @id @default(nanoid())
  title       String
  description String?
  dueDate     DateTime
  createdAt   DateTime             @default(now())
  classId     String
  teacherId   String?
  points      Int?
  class       Class                @relation(fields: [classId], references: [id])
  teacher     Teacher?             @relation(fields: [teacherId], references: [id])
  submissions HomeworkSubmission[]
}

model HomeworkSubmission {
  id          String    @id @default(nanoid())
  content     String? 
  description String?
  submittedAt DateTime  @default(now())
  score       Int?
  feedback    String?
  reviewedAt  DateTime?
  studentId   String
  homeworkId  String
  homework    Homework  @relation(fields: [homeworkId], references: [id])
  status      SubmissionStatus @default(NONSUBMITTED)

  student Student @relation(fields: [studentId], references: [id])
}


model Admin {
  id        String   @id @default(nanoid())
  name      String
  password  String
  createdAt DateTime @default(now())  
 
}